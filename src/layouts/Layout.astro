---
import "../styles/global.css";
import SiteHeader from "../components/marketing/SiteHeader.astro";
import SiteFooter from "../components/marketing/SiteFooter.astro";
import JsonLdScript from "../components/seo/JsonLd.astro";
import { absoluteUrl, siteConfig } from "../lib/site";
import { organizationSchema, websiteSchema, type JsonLd } from "../lib/structured-data";

interface Props { title?: string; description?: string; canonicalPath?: string; socialImage?: string; type?: "website" | "article"; noindex?: boolean; structuredData?: JsonLd[]; showLanguageToggle?: boolean; pageEvent?: string; }
const { title = siteConfig.defaultTitle, description = siteConfig.defaultDescription, canonicalPath = "/", socialImage = siteConfig.defaultSocialImage, type = "website", noindex = false, structuredData = [], showLanguageToggle = false, pageEvent } = Astro.props;
const canonical = absoluteUrl(canonicalPath);
const schemas = canonicalPath === "/" ? [organizationSchema(), websiteSchema(), ...structuredData] : [organizationSchema(), ...structuredData];
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER || "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/logo.png" /><link rel="canonical" href={canonical} />
    <title>{title}</title><meta name="description" content={description} />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}{noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} /><meta property="og:site_name" content={siteConfig.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={absoluteUrl(socialImage)} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absoluteUrl(socialImage)} /><meta name="theme-color" content="#FFFAF2" />
    {schemas.map((schema) => <JsonLdScript data={schema} />)}
  </head>
  <body data-analytics-provider={provider} data-page-event={pageEvent}>
    <a class="skip-link" href="#content">Skip to content</a><SiteHeader showLanguageToggle={showLanguageToggle} />
    <main id="content"><slot /></main><SiteFooter />
    <script>
      const body = document.body;
      const provider = body.dataset.analyticsProvider;
      const integrations = window as Window & { umami?: { track: (event: string, properties: Record<string, string>) => void }; va?: (event: string, properties: { name: string; data: Record<string, string> }) => void };
      function track(event: string, properties: Record<string, string> = {}) {
        if (provider === "umami" && typeof integrations.umami?.track === "function") integrations.umami.track(event, properties);
        if (provider === "vercel" && typeof integrations.va === "function") integrations.va("event", { name: event, data: properties });
      }
      if (provider) {
        const pageEvent = body.dataset.pageEvent;
        if (pageEvent) track(pageEvent);
        document.querySelectorAll<HTMLElement>("[data-track-event]").forEach((element) => element.addEventListener("click", () => { const properties: Record<string, string> = { location: element.dataset.trackLocation || "unknown" }; if (element.dataset.trackSlug) properties.slug = element.dataset.trackSlug; track(element.dataset.trackEvent || "interaction", properties); }));
      }
      const root = document.documentElement;
      const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
      if (buttons.length) {
        const sync = () => { const lang = root.lang; buttons.forEach((button) => { const active = button.dataset.langBtn === lang; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); }); };
        const lang = localStorage.getItem("homepage-lang"); if (lang === "es" || lang === "en") root.lang = lang;
        buttons.forEach((button) => button.addEventListener("click", () => { root.lang = button.dataset.langBtn || "en"; localStorage.setItem("homepage-lang", root.lang); sync(); })); sync();
      }
    </script>
  </body>
</html>
