---
import type { BlogPost } from "../../lib/blog";
import { postUrl, readingTime } from "../../lib/blog";
interface Props { post: BlogPost; featured?: boolean; }
const { post, featured = false } = Astro.props;
---
<article class:list={["article-card", { featured }]}><p class="eyebrow">{post.data.category}</p><h2><a href={postUrl(post)}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="article-meta"><time datetime={post.data.publishedDate.toISOString()}>{post.data.publishedDate.toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric" })}</time><span>{readingTime(post)}</span></div>{!featured && <ul class="tag-list">{post.data.tags.slice(0, 2).map((tag) => <li>{tag}</li>)}</ul>}<a class="text-link" href={postUrl(post)}>Read article</a></article>
