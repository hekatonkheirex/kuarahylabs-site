---
import Layout from "../layouts/Layout.astro";
import GooglePlayCta from "../components/marketing/GooglePlayCta.astro";
import SectionHeading from "../components/marketing/SectionHeading.astro";
import { siteConfig } from "../lib/site";
import { getCollection } from "astro:content";
import { postUrl, publicPosts } from "../lib/blog";
const latestGuides = publicPosts(await getCollection("blog")).slice(0, 3);
---
<Layout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription} canonicalPath="/" showLanguageToggle>
  <section class="home-hero"><div class="container hero-grid"><div><p class="eyebrow"><span data-lang="en">Kuarahy Labs</span><span data-lang="es">Kuarahy Labs</span></p><h1><span data-lang="en">Focused, privacy-first apps for everyday life.</span><span data-lang="es">Apps enfocadas y respetuosas con tu privacidad para el día a día.</span></h1><p class="hero-copy"><span data-lang="en">Kuarahy Labs creates simple software that helps people organize important parts of their daily lives.</span><span data-lang="es">Kuarahy Labs crea software simple que ayuda a organizar partes importantes de la vida cotidiana.</span></p><div class="hero-actions"><a class="button" href="/apps/pawrecord"><span data-lang="en">Explore PawRecord</span><span data-lang="es">Explora PawRecord</span></a><GooglePlayCta location="homepage-hero" /></div></div><img src="/logo.png" alt="Kuarahy Labs logo" width="240" height="240" class="hero-logo" /></div></section>
  <section id="apps" class="section"><div class="container"><SectionHeading eyebrow="Current app" title="PawRecord" description="A simple place to organize important pet health records." /><div class="feature-card card"><img src="/pawrecord-icon.svg" alt="PawRecord app icon" width="88" height="88" /><div><h3><span data-lang="en">Your pet’s health, in one place</span><span data-lang="es">La salud de tu mascota, en un solo lugar</span></h3><p><span data-lang="en">Keep records related to veterinary visits, vaccinations, medications, and weight within easy reach.</span><span data-lang="es">Mantén a mano registros de visitas veterinarias, vacunas, medicamentos y peso.</span></p><div class="hero-actions"><a class="text-link" href="/apps/pawrecord"><span data-lang="en">Learn about PawRecord</span><span data-lang="es">Conoce PawRecord</span></a><GooglePlayCta location="homepage-apps" /></div></div></div></div></section>
  <section class="section"><div class="container"><SectionHeading eyebrow="Latest guides" title="Practical pet-record guidance." description="Short, general guides for keeping important information organized." /><div class="latest-guides">{latestGuides.map((post) => <article><p class="eyebrow">{post.data.category}</p><h3><a href={postUrl(post)}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div><a class="text-link" href="/blog">Browse all pet-care guides</a></div></section>
  <section id="about" class="section section-alt"><div class="container"><SectionHeading eyebrow="About" title="Small studio. Useful software." /><p class="body-copy"><span data-lang="en">Kuarahy Labs is a solo app studio designing, building, and shipping focused tools with care. The name comes from “kuarahy,” the Guaraní word for sun: small, warm software made for real life.</span><span data-lang="es">Kuarahy Labs es un estudio de una sola persona que diseña, construye y publica herramientas enfocadas con cuidado. El nombre viene de “kuarahy”, la palabra guaraní para sol: software chico y cálido hecho para la vida real.</span></p><a class="text-link" href="/about"><span data-lang="en">More about the studio</span><span data-lang="es">Más sobre el estudio</span></a></div></section>
  <section id="contact" class="section"><div class="container"><SectionHeading eyebrow="Contact" title="Get in touch" /><p class="body-copy"><span data-lang="en">Questions, feedback, or support for PawRecord? Send a note.</span><span data-lang="es">¿Preguntas, comentarios o soporte para PawRecord? Escríbenos.</span></p><a class="text-link" href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a></div></section>
</Layout>
<style>
  .home-hero{padding:clamp(4rem,10vw,7.5rem) 0;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.5fr .5fr;gap:3rem;align-items:center}.hero-copy{font-size:clamp(1.05rem,2vw,1.25rem);color:var(--color-text-muted);max-width:39rem;margin:1.25rem 0 0}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem;align-items:center}.hero-logo{width:min(100%,15rem);justify-self:end}.feature-card{display:grid;grid-template-columns:auto 1fr;gap:1.5rem;align-items:start;max-width:50rem}.feature-card img{border-radius:1.3rem}.feature-card h3{margin:0}.feature-card p,.body-copy,.latest-guides p{color:var(--color-text-muted);max-width:44rem;font-size:1.05rem}.latest-guides{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-bottom:1.5rem}.latest-guides article{border-top:1px solid var(--color-border);padding-top:1rem}.latest-guides h3{margin:.2rem 0}.latest-guides h3 a{color:var(--color-text);text-decoration:none}.text-link{font-weight:700}@media(max-width:42rem){.hero-grid,.latest-guides{grid-template-columns:1fr}.hero-logo{display:none}.feature-card{grid-template-columns:1fr}.feature-card img{width:72px;height:72px}}
</style>
