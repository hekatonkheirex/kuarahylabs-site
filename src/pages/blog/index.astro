---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/marketing/Breadcrumbs.astro";
import PageHero from "../../components/marketing/PageHero.astro";
import ArticleCard from "../../components/blog/ArticleCard.astro";
import { publicPosts } from "../../lib/blog";
import { breadcrumbSchema } from "../../lib/structured-data";
const posts = publicPosts(await getCollection("blog"));
const featured = posts.find((post) => post.data.featured);
---
<Layout title="Pet-care guides | Kuarahy Labs" description="Practical guides for organizing your pet’s health information and preparing for veterinary visits." canonicalPath="/blog" structuredData={[breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Pet-care guides", path: "/blog" }])] }><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Pet-care guides" }]} /><PageHero eyebrow="Pet-care guides" title="Practical guides for organizing your pet’s health information." description="Clear, general guidance for keeping veterinary visits, vaccination records, medication information, and other important details organized." /><section class="section"><div class="container">{featured ? <><p class="eyebrow">Featured guide</p><ArticleCard post={featured} featured /></> : <div class="empty-state card"><h2>Guides are on their way.</h2><p>Check back soon for practical record-keeping resources.</p></div>}</div></section>{posts.length > 0 && <section class="section section-alt"><div class="container"><h2 class="listing-title">All guides</h2><div class="article-grid">{posts.map((post) => <ArticleCard post={post} />)}</div><aside class="blog-cta"><p>Looking for one place to organize your pet’s veterinary visits, vaccinations, medications, and weight records?</p><a class="text-link" href="/apps/pawrecord">Explore PawRecord for Android</a></aside></div></section>}</Layout>
<style>.article-card{border-top:1px solid var(--color-border);padding:1.4rem 0}.article-card h2{font-size:clamp(1.4rem,3vw,2rem);margin:.2rem 0}.article-card h2 a{color:var(--color-text);text-decoration:none}.article-card p:not(.eyebrow){color:var(--color-text-muted);max-width:45rem}.article-card.featured{max-width:52rem;padding:clamp(1.5rem,5vw,3rem);border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-card)}.article-meta{display:flex;gap:.8rem;color:var(--color-text-muted);font-size:.86rem;margin:1rem 0}.article-meta span:before{content:"·";margin-right:.8rem}.tag-list{display:flex;gap:.45rem;flex-wrap:wrap;list-style:none;padding:0;margin:0 0 1rem}.tag-list li{font-size:.75rem;background:var(--primary-container);padding:.25rem .5rem;border-radius:999px}.article-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem 2.5rem}.listing-title{margin:0}.blog-cta{max-width:50rem;margin:3rem auto 0;padding:1.4rem 0;border-top:1px solid var(--color-border)}.blog-cta p{color:var(--color-text-muted)}@media(max-width:42rem){.article-grid{grid-template-columns:1fr}}</style>
