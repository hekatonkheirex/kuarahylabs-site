---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/marketing/Breadcrumbs.astro";
import ArticleCta from "../../components/blog/ArticleCta.astro";
import MedicalDisclaimer from "../../components/blog/MedicalDisclaimer.astro";
import RelatedArticles from "../../components/blog/RelatedArticles.astro";
import { postUrl, publicPosts, readingTime, relatedPosts } from "../../lib/blog";
import { absoluteUrl, siteConfig } from "../../lib/site";
import { articleSchema, breadcrumbSchema } from "../../lib/structured-data";

export async function getStaticPaths() { const posts = publicPosts(await getCollection("blog")); return posts.map((post) => ({ params: { slug: post.id.replace(/\.md$/, "") }, props: { post, posts } })); }
const { post, posts } = Astro.props;
const { Content } = await render(post);
const path = postUrl(post);
const date = (value: Date) => value.toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric" });
const schemas = [breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Pet-care guides", path: "/blog" }, { name: post.data.title, path }]), articleSchema({ headline: post.data.title, description: post.data.description, datePublished: post.data.publishedDate.toISOString(), ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}), author: { "@type": "Organization", name: post.data.author }, publisher: { "@type": "Organization", name: siteConfig.name }, mainEntityOfPage: absoluteUrl(path), ...(post.data.socialImage ? { image: absoluteUrl(post.data.socialImage) } : {}) })];
---
<Layout title={`${post.data.title} | Kuarahy Labs`} description={post.data.description} canonicalPath={path} type="article" socialImage={post.data.socialImage} structuredData={schemas} pageEvent="blog_article_view"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Pet-care guides", href: "/blog" }, { label: post.data.title }]} /><article class="article"><header class="article-header"><p class="eyebrow">{post.data.category}</p><h1>{post.data.title}</h1><p class="standfirst">{post.data.description}</p><div class="article-meta"><time datetime={post.data.publishedDate.toISOString()}>Published {date(post.data.publishedDate)}</time>{post.data.updatedDate && <time datetime={post.data.updatedDate.toISOString()}>Updated {date(post.data.updatedDate)}</time>}<span>{post.data.author}</span><span>{readingTime(post)}</span></div></header><MedicalDisclaimer /><div class="article-body"><Content /></div><ArticleCta slug={post.id.replace(/\.md$/, "")} /><RelatedArticles posts={relatedPosts(post, posts)} /></article></Layout>
<style>.article{width:100%;max-width:48rem;margin:0 auto;padding:clamp(2.5rem,6vw,5rem) 1.25rem}.article-header{margin-bottom:2rem}.article h1{font-size:clamp(2.25rem,5vw,4rem)}.standfirst{font-size:1.16rem;color:var(--color-text-muted);max-width:43rem}.article-meta{display:flex;flex-wrap:wrap;gap:.5rem .9rem;color:var(--color-text-muted);font-size:.85rem}.article-meta span,.article-meta time+time:before,.article-meta time+span:before{content:""}.medical-disclaimer{margin:2rem 0;padding:1rem 1.15rem;border-left:4px solid var(--primary-dark);background:var(--primary-container);color:var(--color-text-muted)}.medical-disclaimer strong{color:var(--color-text)}.article-body{font-size:1.06rem}.article-body :global(h2){margin-top:2.6rem}.article-body :global(h3){margin-top:2rem}.article-body :global(p),.article-body :global(li){max-width:70ch}.article-body :global(li+li){margin-top:.45rem}.article-body :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}.article-body :global(th),.article-body :global(td){border:1px solid var(--color-border);padding:.7rem;text-align:left}.article-cta{margin:3rem 0;padding:1.5rem;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface)}.article-cta h2{font-size:1.6rem;margin:.2rem 0}.article-cta p:not(.eyebrow){color:var(--color-text-muted)}.related{margin-top:3.5rem;border-top:1px solid var(--color-border);padding-top:2rem}.related h2{font-size:1.7rem}.related .article-grid{display:grid;grid-template-columns:1fr;gap:0}.related .article-card h2{font-size:1.3rem}</style>
